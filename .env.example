# PostgreSQL de desarrollo. Nunca usar credenciales de producción aquí.
DATABASE_URL=postgresql://orosblooms:orosblooms_dev@localhost:54329/orosblooms_dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos transaccionales con Resend. El remitente debe pertenecer a un dominio verificado.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=OrosBlooms <pedidos@tu-dominio.com>
RESEND_NOTIFICATION_EMAIL=jlmejias22@gmail.com

# Cloudflare R2: bucket público para multimedia y uno privado para comprobantes y referencias.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BUCKET=orosblooms-public
CLOUDFLARE_R2_PRIVATE_BUCKET=orosblooms-private
# Dominio público conectado al bucket, por ejemplo: https://media.tu-dominio.com
CLOUDFLARE_R2_PUBLIC_URL=
# Opcional para video gestionado con Cloudflare Stream.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Cobros. Stripe usa Checkout hospedado; SINPE recibe un comprobante para revisión administrativa.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SINPE_MOBILE_NUMBER=
DELIVERY_FEE_CRC=0

# Información pública real del negocio. Dejar vacía una opción la oculta del sitio.
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_INSTAGRAM_URL=
BUSINESS_FACEBOOK_URL=
BUSINESS_HOURS=
BUSINESS_DELIVERY_AREA=
BUSINESS_DELIVERY_NOTICE=

# Obligatorios antes de desplegar la administración.
ADMIN_EMAIL=admin@orosblooms.local
ADMIN_PASSWORD=cambiar-esta-contrasena
ADMIN_SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
