{
  "name": "orosblooms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "storage:report": "node scripts/storage-report.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-db.cjs",
    "db:check": "node --experimental-strip-types scripts/check-db.ts",
    "db:seed": "node --experimental-strip-types scripts/seed-db.ts",
    "db:clear": "node scripts/clear-db.cjs",
    "db:check-business": "node --experimental-strip-types scripts/check-business-db.ts",
    "qa:setup": "node scripts/qa-setup.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@next/env": "^16.3.5",
    "antd": "^6.6.5",
    "drizzle-orm": "^0.45.3",
    "formik": "^2.4.9",
    "next": "^16.3.5",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.28.1",
    "yup": "^1.7.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
