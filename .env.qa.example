# Copia a .env.local únicamente en un entorno QA local y aislado.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orosblooms_qa
QA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orosblooms_qa
ADMIN_EMAIL=admin@orosblooms.qa
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REEMPLAZAR_SALT$REEMPLAZAR_HASH
ADMIN_SESSION_SECRET=reemplaza-con-al-menos-32-caracteres-aleatorios
ALLOW_INSECURE_LOCAL_ADMIN=false
LOCAL_STORAGE_FOR_QA=true
SINPE_MOBILE_NUMBER=70000000
DELIVERY_FEE_CRC=3000
EMAIL_TRANSPORT=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
